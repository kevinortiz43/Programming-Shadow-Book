      "boundElements": [],
      "updated": 1760212073381,
      "link": null,
      "locked": false,
      "text": "Back in f(0): nQueens(board = 4, row = 0)\n\ncontinue for loop: iter 2: col = 1\n\nLine 19: BACKTRACKING here\nchange cell back to false\nremove Q1\n\nfor loop: iter 3, col = 2\n\nplace Q1 at  (0, 2)\n\nstart recursive call f(1b)",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Back in f(0): nQueens(board = 4, row = 0)\n\ncontinue for loop: iter 2: col = 1\n\nLine 19: BACKTRACKING here\nchange cell back to false\nremove Q1\n\nfor loop: iter 3, col = 2\n\nplace Q1 at  (0, 2)\n\nstart recursive call f(1b)",
      "autoResize": true,
      "lineHeight": 1.25
    },
