      "updated": 1760118981346,
      "link": null,
      "locked": false,
      "text": "number of cells of diag right\ncolumns that are to right of Q3a location:\nboard.length - col - 1 or 4 - 2- 1 = 1 col\n\nmaxRight = Math.min(row, board.length - col - 1)\nmaxRight for Q3a (2, 2) = Math.min(2, 1) = 1 cell\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "number of cells of diag right\ncolumns that are to right of Q3a location:\nboard.length - col - 1 or 4 - 2- 1 = 1 col\n\nmaxRight = Math.min(row, board.length - col - 1)\nmaxRight for Q3a (2, 2) = Math.min(2, 1) = 1 cell\n",
      "autoResize": true,
